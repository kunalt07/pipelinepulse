# Backend configuration. Copy to backend/.env when running the backend
# directly with `uvicorn` (not needed when using docker compose, which
# injects these from the root .env).

# Airflow REST API
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin

# PostgreSQL connection string for PipelinePulse's own tables
DATABASE_URL=postgresql://airflow:airflow@localhost:5432/airflow

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: incoming webhook for failure alerts (Slack/Discord/Mattermost/etc.)
WEBHOOK_URL=
AIRFLOW_PUBLIC_URL=

# Optional: public URL of this PipelinePulse instance, used in scheduled-report
# webhook payloads so the message links back to the Reports view in the app.
PUBLIC_BASE_URL=http://localhost:3000

# Optional: HTTP basic auth (both required to enable)
AUTH_USER=
AUTH_PASS=
