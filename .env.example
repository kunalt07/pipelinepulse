# Used by docker-compose. Copy this file to .env and fill in real values.

# Required: Google Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the default Gemini model.
# `gemini-flash-lite-latest` is free-tier friendly. Upgrade to `gemini-2.5-flash`
# or `gemini-2.5-pro` for higher quality (may require billing).
GEMINI_MODEL=gemini-flash-lite-latest

# Local UID for Airflow file ownership (run `id -u` on Linux/macOS)
AIRFLOW_UID=50000

# Where the frontend reaches the backend (browser-side URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Origins allowed to call the backend (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Optional: incoming-webhook URL for failure alerts.
# Slack: https://hooks.slack.com/services/...
# Discord: https://discord.com/api/webhooks/.../slack  (note the /slack suffix)
# Mattermost / Google Chat / generic: any URL accepting `{"text": "..."}` JSON
WEBHOOK_URL=

# Optional: public Airflow URL used in alert links (defaults to AIRFLOW_BASE_URL).
# Set this if your Airflow has a different external hostname than the one the
# backend uses internally (common when running behind a proxy).
AIRFLOW_PUBLIC_URL=

# Optional: lock the dashboard behind HTTP basic auth.
# If left blank, the dashboard is open to anyone who can reach it.
# Both must be set for auth to be active.
AUTH_USER=
AUTH_PASS=
